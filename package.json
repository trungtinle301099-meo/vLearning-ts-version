{
  "name": "vlearningts",
  "version": "1.0.0",
  "description": "Playwright TypeScript automation framework for vLearning project",
  "private": true,
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test --project=api",
    "test:ui": "playwright test --project=chromium",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:report": "playwright show-report reports/playwright/html",
    "allure:generate": "allure generate reports/playwright/allure-results -o reports/playwright/allure-report --clean",
    "allure:open": "allure open reports/playwright/allure-report",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "type-check": "tsc --noEmit",
    "clean": "rimraf reports/playwright/allure-results reports/playwright/allure-report reports/playwright/html reports/playwright/junit reports/playwright/test-results reports/k6/html reports/k6/summary reports/k6/raw logs/*",
    "check": "npm run type-check && npm run lint && npm run format:check",
    "k6:smoke": "k6 run performance/k6/scripts/smoke.test.js",
    "k6:load": "k6 run performance/k6/scripts/load.test.js"
  },
  "keywords": [
    "playwright",
    "typescript",
    "api-testing",
    "ui-testing",
    "k6",
    "allure"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@faker-js/faker": "^10.5.0",
    "@playwright/test": "^1.61.1",
    "@types/fs-extra": "^11.0.4",
    "@types/k6": "^2.0.0",
    "@types/node": "^26.1.0",
    "allure-commandline": "^2.43.0",
    "allure-playwright": "^3.10.2",
    "cross-env": "^10.1.0",
    "dayjs": "^1.11.21",
    "dotenv": "^17.4.2",
    "eslint": "^10.6.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-playwright": "^2.10.4",
    "fast-xml-parser": "^5.9.3",
    "fs-extra": "^11.3.6",
    "prettier": "^3.9.4",
    "rimraf": "^6.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.1",
    "zod": "^4.4.3"
  }
}
